# Copier en .env (JAMAIS commité). Secrets réels -> SOPS (secrets/*.sops.yaml).

# IP de la VM Docker sur le HomeLab (source unique pour la doc et l'attaque).
# La trouver sur la VM : ip -4 addr | grep -oP '(?<=inet\s)\d+(\.\d+){3}'
HOST_IP=127.0.0.1

POSTGRES_USER=payment
POSTGRES_DB=payment
DRY_RUN=true

# --- Secrets : valeurs de DÉMO uniquement (lab fictif) -----------------------
# PAS de secret réel dans le dépôt : ni le compose ni le code n'ont de repli en
# dur, la stack lit ces valeurs depuis le .env local (non versionné).
# EN PRODUCTION : remplacer par des valeurs fortes (gérées via SOPS), jamais
# commiter le .env réel. La stack REFUSE de démarrer si une valeur est vide.
POSTGRES_PASSWORD=demo-pg-lab
JWT_SECRET=demo-jwt-lab-change-me
GRAFANA_PASSWORD=demo-admin-lab
# Compte de la transaction canari de la remédiation (login sur auth)
CANARY_USER=demo
CANARY_PASSWORD=demo123
