# Copier en .env (JAMAIS commité). Secrets réels -> SOPS (secrets/*.sops.yaml).

# IP de la VM Docker sur le HomeLab (source unique pour la doc et l'attaque).
# La trouver sur la VM : ip -4 addr | grep -oP '(?<=inet\s)\d+(\.\d+){3}'
HOST_IP=127.0.0.1

POSTGRES_USER=payment
POSTGRES_DB=payment
DRY_RUN=true

# --- Secrets REQUIS (aucune valeur par défaut dans le dépôt) -----------------
# À renseigner dans le .env local (non versionné) AVANT `docker compose up`.
# La stack REFUSE de démarrer si l'un d'eux est vide/absent.
POSTGRES_PASSWORD=
JWT_SECRET=
GRAFANA_PASSWORD=
# Compte de la transaction canari de la remédiation (login sur auth)
CANARY_USER=demo
CANARY_PASSWORD=demo123
